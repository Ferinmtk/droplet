<Window x:Class="Droplet.Windows.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="600" MinWidth="340" MinHeight="360"
        WindowStartupLocation="CenterScreen" Icon="/Assets/droplet.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock x:Name="PeerName" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0" />
            <TextBlock x:Name="PeerRoute" Style="{StaticResource Caption}" />
        </StackPanel>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Messages">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border HorizontalAlignment="{Binding Side}" MaxWidth="340" Margin="0,3" Padding="12,8" CornerRadius="12"
                                BorderThickness="1" BorderBrush="{DynamicResource DropletLineBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DropletCardBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mine}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DropletAccentSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="SendButton" Content="Send" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Margin="8,0,0,0"
                    VerticalAlignment="Bottom" Click="Send_Click" />
            <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="Input_PreviewKeyDown" AutomationProperties.Name="Message" />
        </DockPanel>
        <TextBlock x:Name="Error" Grid.Row="3" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
    </Grid>
</Window>
