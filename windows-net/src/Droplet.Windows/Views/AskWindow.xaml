<Window x:Class="Droplet.Windows.Views.AskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="droplet" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Icon="pack://application:,,,/droplet;component/Assets/droplet.ico">
    <!-- one line to type: a link to send, a nickname, a message for several devices -->
    <StackPanel Margin="24,20,24,22">
        <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="20" TextWrapping="Wrap" />
        <TextBlock x:Name="Explain" Style="{StaticResource Caption}" Margin="0,0,0,12" />
        <TextBox x:Name="Answer" AutomationProperties.Name="Answer" TextChanged="Answer_TextChanged" />
        <TextBlock x:Name="Problem" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" Style="{StaticResource PlainButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
