<UserControl x:Class="Droplet.Windows.Views.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- one device in the Devices window: how it's reached, what's shared with it, what's on its way, and what to do -->
    <StackPanel>
        <WrapPanel>
            <TextBlock x:Name="DetailName" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0,0,10,6" />
            <TextBlock x:Name="RealName" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,6" Visibility="Collapsed"
                       ToolTip="Its own name. The nickname is only on this PC: it's never sent." />
            <Border x:Name="OtherBadge" Style="{StaticResource Badge}" Visibility="Collapsed"
                    ToolTip="Someone else's device: you chose what it may do, under Permissions">
                <TextBlock Text="Someone else's" FontSize="12" />
            </Border>
            <Border x:Name="PausedBadge" Style="{StaticResource Badge}" Visibility="Collapsed"
                    Background="{DynamicResource DropletWarnSoftBrush}" BorderBrush="{DynamicResource DropletWarnBrush}">
                <TextBlock x:Name="PausedBadgeText" FontSize="12" />
            </Border>
        </WrapPanel>
        <TextBlock x:Name="DetailRoute" Style="{StaticResource Caption}" Margin="0,0,0,12" />
        <WrapPanel>
            <Button x:Name="SendFilesButton" Content="Send files…" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="MessageButton" Content="Message…" Style="{StaticResource PlainButton}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="LinkButton" Content="Send a link…" Style="{StaticResource PlainButton}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="ClipboardButton" Content="Send clipboard" Style="{StaticResource PlainButton}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="RingButton" Content="Ring" Style="{StaticResource PlainButton}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="PauseButton" Content="Pause" Style="{StaticResource PlainButton}" Margin="0,0,8,8" />
            <Button x:Name="PermissionsButton" Content="Permissions…" Style="{StaticResource PlainButton}" Margin="0,0,8,8" />
            <Button x:Name="NicknameButton" Content="Nickname…" Style="{StaticResource PlainButton}" Margin="0,0,8,8"
                    ToolTip="What this PC calls it. Only here: it's never sent." />
            <Button x:Name="UnpairButton" Content="Unpair" Style="{StaticResource PlainButton}" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock x:Name="DetailNote" Style="{StaticResource Caption}" Margin="0,4,0,0" />

        <!-- files on their way, either way: a thin bar, how far and how fast, and Cancel -->
        <StackPanel x:Name="TransfersPanel" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="Files" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
            <ItemsControl x:Name="Transfers" AutomationProperties.Name="Files on their way">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,4,0,6">
                            <Button Content="Cancel" Style="{StaticResource PlainButton}" MinWidth="0" Padding="10,3" DockPanel.Dock="Right"
                                    VerticalAlignment="Center" Margin="10,0,0,0" Tag="{Binding Id}" Visibility="{Binding CancelVisibility}"
                                    Click="Cancel_Click" AutomationProperties.Name="Cancel" />
                            <StackPanel>
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Way, Mode=OneWay}" Foreground="{DynamicResource DropletDimBrush}" />
                                </TextBlock>
                                <ProgressBar Height="4" Margin="0,4,0,3" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                             IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" Visibility="{Binding BarVisibility}" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
