<Window x:Class="Droplet.Windows.Views.PermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="droplet permissions" Width="600" Height="760" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/droplet;component/Assets/droplet.ico">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DropletLineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button Content="Done" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" IsDefault="True" IsCancel="True" Click="Done_Click" />
                <TextBlock Text="Changes are saved as you make them." Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,12">
                <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="20" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14">
                    This PC checks these itself, both ways, whatever the other device does.
                </TextBlock>

                <Border x:Name="PausedAllBanner" Style="{StaticResource Banner}" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Text="Everything is paused on this PC: nothing is shared with any device until you resume it." />
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Whose device is it?" Style="{StaticResource SectionTitle}" />
                        <RadioButton x:Name="OwnRadio" GroupName="relation" Click="Relation_Click" Margin="0,2,0,0" />
                        <TextBlock x:Name="OwnLine" Style="{StaticResource Caption}" Margin="28,0,0,8" />
                        <RadioButton x:Name="OtherRadio" GroupName="relation" Click="Relation_Click" />
                        <TextBlock x:Name="OtherLine" Style="{StaticResource Caption}" Margin="28,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="Choosing again sets the switches below to its defaults." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="What's shared" Style="{StaticResource SectionTitle}" />
                        <StackPanel x:Name="Switches" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="PausedBox" Style="{StaticResource Switch}" Click="Paused_Click" />
                        <TextBlock Style="{StaticResource Caption}" Margin="28,0,0,0">
                            Nothing goes to it or comes from it until you resume. It's told, and messages and files you send it wait.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TheirWord" Style="{StaticResource Caption}" Margin="2,0,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
