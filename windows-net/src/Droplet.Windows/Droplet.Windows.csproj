<Project Sdk="Microsoft.NET.Sdk">
  <!--
    droplet for Windows: the WPF shell around Droplet.Core. The tray, the windows, and
    the Windows side of every platform service (SendInput, Core Audio and the media
    sessions, the clipboard, toasts, screenshots, DPAPI...). It builds on Linux with
    EnableWindowsTargeting, and runs on Windows 10 2004 or later.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the WinRT projection (media sessions, toasts, StartupTask) comes with this TFM -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <AssemblyName>droplet</AssemblyName>
    <RootNamespace>Droplet.Windows</RootNamespace>
    <StartupObject>Droplet.Windows.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\droplet.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- dates and numbers in the person's own format -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>2.0.0</Version>
    <Description>droplet: your devices, together, on your own network</Description>
    <!--
      WPF doesn't support trimming. Single-file and self-contained are set when
      publishing (see the README and the workflow), not here.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      WPF0001: ThemeMode (the Fluent theme that follows the system's light and dark
      setting) is marked experimental in the SDK; it's the supported way to get it.
      CA1416 is kept: everything here targets Windows 10 2004 and later.
    -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Droplet.Core/Droplet.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\droplet.ico" />
    <Resource Include="Assets\droplet-256.png" />
    <EmbeddedResource Include="Assets\tray.ico" LogicalName="tray.ico" />
    <EmbeddedResource Include="Assets\tray-dim.ico" LogicalName="tray-dim.ico" />
    <EmbeddedResource Include="Assets\tray-live.ico" LogicalName="tray-live.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Droplet.Windows.Tests" />
  </ItemGroup>
</Project>
