<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      droplet's look on top of WPF's Fluent theme: the web app's teal accent (Palette.cs
      sets the colours for light or dark), cards, and a few text styles. Fluent itself
      follows the system's light/dark setting (App.xaml: ThemeMode="System").
    -->
    <SolidColorBrush x:Key="DropletAccentBrush" Color="#4DE8D4" />
    <SolidColorBrush x:Key="DropletOnAccentBrush" Color="#032824" />
    <SolidColorBrush x:Key="DropletAccentSoftBrush" Color="#1F4DE8D4" />
    <SolidColorBrush x:Key="DropletDimBrush" Color="#7D9DA0" />
    <SolidColorBrush x:Key="DropletLineBrush" Color="#33808080" />
    <SolidColorBrush x:Key="DropletCardBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="DropletWarnBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DropletOkBrush" Color="#0FAE9C" />

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DropletDimBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#E5484D" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DropletCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DropletLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DropletAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DropletAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource DropletAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DropletOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DropletAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinWidth" Value="88" />
    </Style>

    <Style x:Key="PlainButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="80" />
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="0,4,0,2" />
    </Style>

    <Style x:Key="Code" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DropletAccentBrush}" />
        <Setter Property="Margin" Value="0,4,0,8" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
