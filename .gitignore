# Python
.venv/
__pycache__/
*.pyc

# agent worktrees / local tooling scratch
.claude/

# Secrets — never commit
.secret_key
certs/

# Runtime file storage — keep the directories, ignore their contents
received/*
!received/.gitkeep
shared/*
!shared/.gitkeep

# Docker Compose bind-mount target (DROPLET_HOME inside the container)
data/
