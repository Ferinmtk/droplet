# Copy to ~/.config/droplet/droplet.env and adjust as needed.
# Only variables you uncomment/set take effect — droplet falls back to its
# built-in defaults for anything left out. See app.py / README.md for details.

# Listen port
#DROPLET_PORT=8000

# Bind address
#DROPLET_HOST=0.0.0.0

# Address to advertise in the QR code, banner, mDNS record and cert.
# Set this when the host is on more than one network and the
# autodetected address is the wrong one.
#DROPLET_LAN_IP=192.168.1.50

# Require this PIN before access. Leave unset/empty to disable.
#DROPLET_PIN=1234

# 1 = HTTPS with a persistent self-signed cert (browser will warn once).
#DROPLET_HTTPS=1

# mDNS hostname (<name>.local)
#DROPLET_NAME=droplet

# Where received/, shared/, certs/ live. Defaults to the app directory —
# useful to point at a different data location when running as a service.
#DROPLET_HOME=/home/youruser/curiosity/projects/droplet

# Max upload size, in MB
#DROPLET_MAX_MB=1024

# 1 = also serve at https://<machine>.<tailnet>.ts.net with a real cert,
# via `tailscale serve`. Needs MagicDNS + HTTPS Certificates on in the
# Tailscale admin console, and `sudo tailscale set --operator=$USER` once.
#DROPLET_TAILSCALE=1

# With DROPLET_PIN set, tailnet devices skip it by default (they're already
# approved on your tailnet). 0 = they enter the PIN too.
#DROPLET_TAILNET_TRUST=1
