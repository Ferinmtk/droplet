<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Droplet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/card</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/line</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/text</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/dim</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorSurfaceContainerHighest">@color/line</item>
        <item name="colorOutline">@color/dim</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/danger</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- the share sheet floats over whatever app shared, so its activity is invisible -->
    <style name="Theme.Droplet.Transparent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- the presentation remote: droplet's dark teal, whatever the system theme -->
    <style name="Theme.Droplet.Remote" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/r_accent</item>
        <item name="colorOnPrimary">@color/r_on_accent</item>
        <item name="colorPrimaryContainer">@color/r_card</item>
        <item name="colorOnPrimaryContainer">@color/r_text</item>
        <item name="colorSecondary">@color/r_accent</item>
        <item name="colorOnSecondary">@color/r_on_accent</item>
        <item name="colorSecondaryContainer">@color/r_card_2</item>
        <item name="colorOnSecondaryContainer">@color/r_text</item>
        <item name="android:colorBackground">@color/r_bg</item>
        <item name="colorOnBackground">@color/r_text</item>
        <item name="colorSurface">@color/r_card</item>
        <item name="colorOnSurface">@color/r_text</item>
        <item name="colorOnSurfaceVariant">@color/r_dim</item>
        <item name="colorSurfaceContainerLowest">@color/r_bg</item>
        <item name="colorSurfaceContainerLow">@color/r_card</item>
        <item name="colorSurfaceContainer">@color/r_card</item>
        <item name="colorSurfaceContainerHigh">@color/r_card</item>
        <item name="colorSurfaceContainerHighest">@color/r_card_2</item>
        <item name="colorOutline">@color/r_line_2</item>
        <item name="colorOutlineVariant">@color/r_line</item>
        <item name="colorError">@color/r_coral</item>
        <item name="android:windowBackground">@color/r_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- setup and pairing: the same dark teal as the web app and the remote -->
    <style name="Theme.Droplet.Teal" parent="Theme.Droplet.Remote" />

    <style name="Droplet.Teal.Eyebrow" parent="">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/r_dim</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Droplet.Teal.Title" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/r_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Droplet.Teal.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/r_dim</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Droplet.Teal.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/r_on_accent</item>
        <item name="backgroundTint">@color/r_accent</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Droplet.Teal.Secondary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/r_text</item>
        <item name="backgroundTint">@color/r_card_2</item>
        <item name="strokeColor">@color/r_line_2</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Droplet.Teal.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/r_accent</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Droplet.Section" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Droplet.Card" parent="">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Droplet.Title" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Droplet.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- the Bluetooth keyboard's keys and the media row -->
    <style name="Droplet.Teal.Key" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/r_text</item>
        <item name="android:maxLines">1</item>
        <item name="backgroundTint">@color/r_card_2</item>
        <item name="strokeColor">@color/r_line_2</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconTint">@color/r_text</item>
        <item name="iconPadding">6dp</item>
    </style>

    <!-- key buttons made in code pick up Droplet.Teal.Key through this -->
    <style name="ThemeOverlay.Droplet.Key" parent="">
        <item name="materialButtonStyle">@style/Droplet.Teal.Key</item>
    </style>

    <style name="Droplet.Teal.Tab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/r_tab_text</item>
        <item name="backgroundTint">@color/r_tab_bg</item>
        <item name="strokeColor">@color/r_line_2</item>
        <item name="iconTint">@color/r_tab_text</item>
    </style>

    <!-- the TV remote's round keys: an icon in a circle -->
    <style name="Droplet.Teal.RoundKey" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">@color/r_card_2</item>
        <item name="strokeColor">@color/r_line_2</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">999dp</item>
        <item name="iconTint">@color/r_text</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- key buttons made in code on the TV remote pick up Droplet.Teal.RoundKey through this -->
    <style name="ThemeOverlay.Droplet.RoundKey" parent="">
        <item name="materialButtonStyle">@style/Droplet.Teal.RoundKey</item>
    </style>

    <!-- the volume and channel rockers: a tall pill with + and - -->
    <style name="Droplet.Teal.Rocker" parent="">
        <item name="android:background">@drawable/tv_rocker</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <!-- the home screen's tiles (TV remote, mouse and keyboard, hub) -->
    <style name="Droplet.Teal.Tile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">112dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/r_card_tap</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Droplet.Teal.TileIcon" parent="">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:tint">@color/r_accent</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Droplet.Teal.TileTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/r_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Droplet.Teal.TileSub" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/r_dim</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- a device's actions on the home screen: an icon over a word, big enough for a thumb -->
    <style name="Droplet.Teal.Action" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@drawable/r_action</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Droplet.Teal.ActionIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:tint">@color/r_accent</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Droplet.Teal.ActionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textColor">@color/r_text</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
