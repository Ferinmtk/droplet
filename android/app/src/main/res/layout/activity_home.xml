<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen (MainActivity): your devices and what to do with them,
     pairing, the phone's own remotes, and what arrived. Always droplet's dark
     teal, with or without a hub. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/r_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- header: droplet, this phone's name, settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_drop_color" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/r_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/me"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/r_dim"
                    android:textSize="13sp"
                    tools:text="This phone: Redmi Note 11E Pro" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:src="@drawable/tv_ic_gear"
                android:tint="@color/r_text"
                tools:ignore="UseAppTint" />
        </LinearLayout>

        <!-- the phone is ringing: stop it -->
        <LinearLayout
            android:id="@+id/ringing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/r_attn"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ring"
                android:tint="@color/r_coral"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/ringing_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/r_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="slim is ringing this phone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ringing_stop"
                style="@style/Droplet.Teal.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/r_coral"
                android:text="@string/stop" />
        </LinearLayout>

        <!-- something about this phone that needs doing (direct connections off, Stay connected off) -->
        <LinearLayout
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/r_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/notice_text"
                style="@style/Droplet.Teal.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/r_text"
                tools:text="Your devices can reach this phone only while droplet is open." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/notice_button"
                style="@style/Droplet.Teal.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                tools:text="Stay connected" />
        </LinearLayout>

        <!-- devices asking to pair with this phone -->
        <LinearLayout
            android:id="@+id/requests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ============ your devices ============ -->
        <TextView
            android:id="@+id/devices_title"
            style="@style/Droplet.Teal.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="@string/home_devices" />

        <LinearLayout
            android:id="@+id/devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- no devices yet: how to get the first one -->
        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/r_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                style="@style/Droplet.Teal.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_empty_title" />

            <TextView
                style="@style/Droplet.Teal.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/home_empty_body"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/step1"
                style="@style/Droplet.Teal.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawablePadding="12dp"
                android:text="@string/home_empty_step1"
                android:textColor="@color/r_text"
                android:textSize="15sp" />

            <TextView
                style="@style/Droplet.Teal.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_empty_step2"
                android:textColor="@color/r_text"
                android:textSize="15sp" />

            <TextView
                style="@style/Droplet.Teal.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_empty_step3"
                android:textColor="@color/r_text"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/share_link"
                style="@style/Droplet.Teal.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/home_share_link"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconTint="@color/r_accent" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pair"
            style="@style/Droplet.Teal.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/home_pair"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/r_on_accent" />

        <!-- ============ this phone's own remotes, and the hub ============ -->
        <TextView
            style="@style/Droplet.Teal.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:text="@string/home_tools" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_tv"
                style="@style/Droplet.Teal.Tile"
                android:layout_marginEnd="5dp">

                <ImageView style="@style/Droplet.Teal.TileIcon" android:src="@drawable/tv_ic_tv"
                    tools:ignore="ContentDescription,UseAppTint" />

                <TextView style="@style/Droplet.Teal.TileTitle" android:text="@string/home_tile_tv" />

                <TextView android:id="@+id/tile_tv_sub" style="@style/Droplet.Teal.TileSub"
                    tools:text="Living room TV" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_bt"
                style="@style/Droplet.Teal.Tile"
                android:layout_marginHorizontal="5dp">

                <ImageView style="@style/Droplet.Teal.TileIcon" android:src="@drawable/ic_touchpad"
                    tools:ignore="ContentDescription,UseAppTint" />

                <TextView style="@style/Droplet.Teal.TileTitle" android:text="@string/home_tile_bt" />

                <TextView android:id="@+id/tile_bt_sub" style="@style/Droplet.Teal.TileSub"
                    android:text="@string/home_tile_bt_sub" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_hub"
                style="@style/Droplet.Teal.Tile"
                android:layout_marginStart="5dp">

                <ImageView style="@style/Droplet.Teal.TileIcon" android:src="@drawable/ic_server"
                    tools:ignore="ContentDescription,UseAppTint" />

                <TextView style="@style/Droplet.Teal.TileTitle" android:text="@string/home_tile_hub" />

                <TextView android:id="@+id/tile_hub_sub" style="@style/Droplet.Teal.TileSub"
                    tools:text="t15 · connected" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ what arrived ============ -->
        <TextView
            android:id="@+id/received_title"
            style="@style/Droplet.Teal.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:text="@string/home_received" />

        <LinearLayout
            android:id="@+id/received"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/r_card"
            android:orientation="vertical"
            android:paddingVertical="4dp" />

        <TextView
            android:id="@+id/messages_title"
            style="@style/Droplet.Teal.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:text="@string/home_messages" />

        <LinearLayout
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/r_card"
            android:orientation="vertical"
            android:paddingVertical="4dp" />
    </LinearLayout>
</ScrollView>
