<?xml version="1.0" encoding="utf-8"?>
<!-- The Bluetooth mouse and keyboard (BluetoothActivity): getting connected
     ("setup"), then the touchpad, keyboard and media keys ("controls"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/r_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="12dp">

    <!-- header: back, title, state -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bt_title"
            android:textColor="@color/r_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/state_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/r_dot" />

        <TextView
            android:id="@+id/state_short"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/r_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= setup: permission, Bluetooth, pairing, connecting ================= -->
        <ScrollView
            android:id="@+id/setup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/r_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/notice_title"
                        style="@style/Droplet.Teal.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/notice_body"
                        style="@style/Droplet.Teal.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/notice_action"
                        style="@style/Droplet.Teal.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/notice_action2"
                        style="@style/Droplet.Teal.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- paired devices: one tap connects -->
                <TextView
                    android:id="@+id/devices_label"
                    style="@style/Droplet.Teal.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/bt_paired" />

                <LinearLayout
                    android:id="@+id/devices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/r_card"
                    android:orientation="vertical"
                    android:paddingVertical="6dp" />

                <!-- pairing a new one -->
                <TextView
                    android:id="@+id/pair_label"
                    style="@style/Droplet.Teal.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/bt_pair_new" />

                <LinearLayout
                    android:id="@+id/pair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/r_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/visible"
                        style="@style/Droplet.Teal.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_visible"
                        app:icon="@drawable/ic_bluetooth"
                        app:iconGravity="textStart"
                        app:iconTint="@color/r_accent" />

                    <TextView
                        android:id="@+id/visible_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/r_accent"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        style="@style/Droplet.Teal.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/bt_pair_intro" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/bt_pair_windows_title"
                        android:textColor="@color/r_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Droplet.Teal.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_pair_windows" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/bt_pair_kde_title"
                        android:textColor="@color/r_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Droplet.Teal.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_pair_kde" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/bt_pair_tv_title"
                        android:textColor="@color/r_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Droplet.Teal.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_pair_tv" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/r_banner"
                        android:padding="12dp"
                        android:text="@string/bt_pair_again"
                        android:textColor="@color/r_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ================= controls: once a host is connected ================= -->
        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- who it's connected to -->
            <LinearLayout
                android:id="@+id/host_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/r_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingVertical="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Droplet.Teal.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_connected_to"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/host_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/r_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/disconnect"
                    style="@style/Droplet.Teal.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bt_disconnect"
                    android:textColor="@color/r_coral" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:checkedButton="@id/tab_pad"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_pad"
                    style="@style/Droplet.Teal.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bt_tab_pad" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_keys"
                    style="@style/Droplet.Teal.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bt_tab_keys" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_media"
                    style="@style/Droplet.Teal.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bt_tab_media" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- touchpad -->
            <LinearLayout
                android:id="@+id/pad_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <dev.droplet.app.TouchpadView
                    android:id="@+id/pad"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/r_pad"
                    android:contentDescription="@string/bt_tab_pad">

                    <TextView
                        android:id="@+id/pad_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:drawablePadding="12dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/bt_pad_hint"
                        android:textColor="@color/r_dim"
                        android:textSize="14sp"
                        app:drawableTopCompat="@drawable/ic_touchpad"
                        app:drawableTint="@color/r_line_2" />

                    <TextView
                        android:id="@+id/pad_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/r_pill"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/r_accent"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </dev.droplet.app.TouchpadView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/left"
                        style="@style/Droplet.Teal.Key"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/bt_left"
                        app:cornerRadius="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/right"
                        style="@style/Droplet.Teal.Key"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="@string/bt_right"
                        app:cornerRadius="20dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- keyboard -->
            <ScrollView
                android:id="@+id/keys_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <EditText
                            android:id="@+id/typing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/r_field"
                            android:importantForAutofill="no"
                            android:inputType="textVisiblePassword|textMultiLine|textNoSuggestions"
                            android:maxLines="3"
                            android:minHeight="56dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp"
                            android:saveEnabled="false"
                            android:textColor="@color/r_text"
                            android:textColorHint="@color/r_dim"
                            android:textSize="17sp" />

                        <!-- the field always holds an invisible marker, so its own hint never shows -->
                        <TextView
                            android:id="@+id/typing_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="17dp"
                            android:labelFor="@id/typing"
                            android:text="@string/bt_type_hint"
                            android:textColor="@color/r_dim"
                            android:textSize="17sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_marginTop="6dp"
                        android:text="@string/bt_type_note"
                        android:textColor="@color/r_dim"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/mods"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/keys"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/Droplet.Teal.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/bt_function_keys" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/fkeys"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        style="@style/Droplet.Teal.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/bt_shortcuts" />

                    <LinearLayout
                        android:id="@+id/shortcuts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <!-- media and TV keys -->
            <LinearLayout
                android:id="@+id/media_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/bt_tv_note"
                    android:textColor="@color/r_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/r_dim"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
