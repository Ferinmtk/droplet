<?xml version="1.0" encoding="utf-8"?>
<!-- a device asking to pair with this phone: the coral card, answered on the pairing screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:background="@drawable/r_attn"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/r_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="office-pc wants to pair" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/r_dim"
            android:textSize="13.5sp"
            tools:text="Check the code on both screens" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/answer"
        style="@style/Droplet.Teal.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:backgroundTint="@color/r_coral"
        android:text="@string/home_request_answer" />
</LinearLayout>
