<?xml version="1.0" encoding="utf-8"?>
<!-- a card that opens something: the remote's card with a ripple -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/r_accent_soft">
    <item>
        <shape>
            <solid android:color="@color/r_card" />
            <stroke android:width="1dp" android:color="@color/r_line" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
