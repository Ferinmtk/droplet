<?xml version="1.0" encoding="utf-8"?>
<!-- a device's one-tap action on the home screen: a soft tile that ripples -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/r_accent_soft">
    <item>
        <shape>
            <solid android:color="@color/r_card_2" />
            <stroke android:width="1dp" android:color="@color/r_line" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
